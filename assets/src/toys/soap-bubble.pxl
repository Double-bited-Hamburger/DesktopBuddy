# A soap bubble from the duck's wand (src/core/toys/bubbles.ts): a thin blue rim with a cyan
# shimmer on the lit top-left, a pink one underneath, and a white glint. The middle is left
# empty (no partial alpha): the desktop shows through. Every frame is centred on the same
# middle, so a bubble pops where it floats.
name: soap-bubble
size: 9x9
palette:
  B #34508a
  C #9fe6f2
  P #f0a6e8
  W #ffffff

@frame small
.........
.........
...BBB...
..BW..B..
..BC.PB..
..B..PB..
...BBB...
.........
.........

@frame medium
...BBB...
.BBCCCBB.
.BCWW..B.
BCW.....B
BC.....PB
B......PB
.B....PB.
.BBPPPBB.
...BBB...

@frame pop-1
....C....
.B.....B.
.........
.........
W.......P
.........
.........
.B.....B.
....P....

@frame pop-2
W.......C
.........
.........
.........
.........
.........
.........
.........
P.......W
