# The duck, facing right; the renderer mirrors it when the duck walks left.
# Body zones (head, body, chest, wing, tail) have their own palette keys so skins can recolor
# each part; see "Body zones" in docs/ART_BIBLE.md. Every color must stay distinct.
name: duck
size: 32x32
anchor: head 20 5
anchor: face 22 10
anchor: neck 22 14
# Palette keys:
#   K  outline
#   E  eye
#   I  eye shine, foam (stays white on every skin)
#   H  head: light
#   A  head: main
#   W  body: main
#   S  body: shade (underside)
#   C  chest and belly
#   G  wing: main
#   V  wing: feather line
#   T  tail
#   O  beak and feet
#   D  beak and feet: dark
#   Y  stars
#   P  cheeks, inside of the beak
palette:
  K #2a1f2d
  E #1e1620
  I #ffffff
  H #fffaf0
  A #f3e8d0
  W #f4e9d1
  S #dcc8a0
  C #fbf3e0
  G #ece0c3
  V #cdb68a
  T #f2e6cc
  O #f2872b
  D #b8561a
  Y #f7d84a
  P #f2a0a0

