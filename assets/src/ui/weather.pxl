# Weather icons for the Home screen's forecast: sun, cloud, fog, rain, snow, storm.
# Flat colors, hard edges, light from the top-left (the cloud's shade sits bottom-right).
name: weather
size: 12x12
palette:
  K #2a1f2d
  W #ffffff
  c #c9d3de
  C #8b98a8
  Y #f2c94c
  y #c9962a
  B #3a74b0
  S #9fd0f0
  G #5c6675

